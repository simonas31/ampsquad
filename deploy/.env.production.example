# =============================================================================
# Production .env template (CloudPanel).
# Copy to: ~/htdocs/ampsquad.lt/.env  (chmod 600). Never commit the filled-in file.
# Fill every blank. Generate APP_KEY on your dev machine:  php artisan key:generate --show
# =============================================================================

APP_NAME=AmpSquad
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ampsquad.lt

APP_LOCALE=lt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=error

# --- Database (create in CloudPanel -> site -> Databases) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --- DB-backed drivers. The queue needs the Supervisor worker (deploy/README.md) ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
# Must exceed the catalog import job's 1800s timeout, or a long import is handed to a second worker.
DB_QUEUE_RETRY_AFTER=1900
BROADCAST_CONNECTION=log

# --- Storage: media library uploads go to storage/app/public ---
FILESYSTEM_DISK=local

# --- Inertia SSR is not used (no SSR bundle is built) ---
INERTIA_SSR_ENABLED=false

# --- Mail: contact-form notifications are queued and sent through this ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@ampsquad.lt"
MAIL_FROM_NAME="${APP_NAME}"
